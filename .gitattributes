# Align repo text files with EditorConfig / agent writes (LF).
# Reduces phantom "dirty" tabs on Windows when core.autocrlf=true.
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.sql  text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Copy to .env for local development (.env is gitignored).

# Development mode — skip license validation when using server.server:app
CIM_DEV=1

# Database override (default: ./data/nse_data.db)
# CIM_DB_PATH=./data/nse_data.db

# GitHub auto-updates
# CIM_GITHUB_OWNER=unnwired
# CIM_GITHUB_REPO=cim-updates
# GITHUB_TOKEN=

# Email / feedback (optional — without SMTP, feedback saves to data/feedback.json)
# NSE_PULSE_SMTP_HOST=smtp.gmail.com
# NSE_PULSE_SMTP_PORT=587
# NSE_PULSE_SMTP_USER=
# NSE_PULSE_SMTP_PASS=
# NSE_PULSE_FROM_EMAIL=

# CORS (comma-separated origins)
# CIM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Upstox market data (Analytics Token — server only; never commit the real value)
# UPSTOX_ANALYTICS_TOKEN=
# CIM_UPSTOX_DISABLED=1

# Per-user Telegram: each account saves bot token + chat id in Alerts UI
# (AES-256-GCM at rest). Optional host-wide KEK — set a long random value so
# stolen user telegram_secrets.json alone cannot be decrypted.
# CIM_TELEGRAM_KEK=

# Legacy single-operator fallback (optional). Prefer per-user credentials.
# Create bot via @BotFather, /start the bot, then get chat id from getUpdates.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
